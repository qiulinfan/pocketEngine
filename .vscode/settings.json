{
    "editor.formatOnType": false,
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.autoIndent": "none",
    "C_Cpp.formatting": "Disabled",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
    "C_Cpp.default.compilerPath": "/usr/bin/g++",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/include/engine",
        "${workspaceFolder}/thirdparty",
        "${workspaceFolder}/thirdparty/box2d/src",
        "${workspaceFolder}/thirdparty/SDL2_image",
        "${workspaceFolder}/thirdparty/SDL2",
        "${workspaceFolder}/thirdparty/SDL2_ttf",
        "${workspaceFolder}/thirdparty/SDL2_mixer",
        "${workspaceFolder}/thirdparty/Lua",
        "${workspaceFolder}/thirdparty/LuaBridge",
        "/usr/include",
        "/usr/local/include"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c17",
    "cmake.ignoreCMakeListsMissing": true
}
